INFOPLIST_KEY_CFBundleDisplayName = ScoreKeep Migration Test
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG SCOREKEEP_MIGRATION_TEST SCOREKEEP_MIGRATION_TEST_LEGACY
